# ==============================================================================
# AutoMaintainer - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==============================================================================

# Environment mode: development | staging | production
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# GitHub Integration
# ------------------------------------------------------------------------------
# For Managed Repositories Mode (via config/managed_repositories.yaml):
GITHUB_TOKEN=ghp_your_github_personal_access_token

# For GitHub App Mode (Enterprise / Webhook integration):
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace_with_a_secure_random_string_min_16_chars

# ------------------------------------------------------------------------------
# Repository Management & Discovery Policy
# ------------------------------------------------------------------------------
# Strictly disable crawling and autonomous actions on unlisted/random repos:
PUBLIC_DISCOVERY_ENABLED=False

# Path to the managed repositories YAML configuration:
MANAGED_REPOSITORIES_FILE=config/managed_repositories.yaml
MANAGED_REPOSITORIES_POLL_INTERVAL=20

# Global defensive rate ceiling: max pull requests opened per hour
MAX_PRS_PER_HOUR=2

# ------------------------------------------------------------------------------
# Multi-Provider Inference (Cerebras, Groq, Google Gemini)
# ------------------------------------------------------------------------------
# Priority order for cross-provider automatic fallback:
# If Cerebras keys fail (429 rate limit/quota/error), it shifts to Groq, then Google.
INFERENCE_PROVIDER_PRIORITY=["cerebras", "groq", "google"]

# 1. Cerebras Cloud Inference (Ultra-fast Llama 3.3 70B & 8B)
CEREBRAS_ENABLED=True
CEREBRAS_API_KEY=csk-your_primary_cerebras_api_key_here
# Multi-key pooling: Comma-separated keys. If key 1 hits 429 rate limit, it automatically shifts to key 2:
# CEREBRAS_API_KEYS=csk-key1_here,csk-key2_here
CEREBRAS_DEFAULT_PLANNER_MODEL=llama3.3-70b
CEREBRAS_DEFAULT_FAST_MODEL=llama3.1-8b

# 2. Groq Cloud Inference (Llama 3.3 70B & 8B Instant)
GROQ_ENABLED=True
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
# Multi-key pooling: Comma-separated keys. If key 1 hits 429 rate limit, it automatically shifts to key 2:
# GROQ_API_KEYS=gsk_key1_here,gsk_key2_here
GROQ_ORG_ID=default_org
GROQ_DEFAULT_PLANNER_MODEL=llama-3.3-70b-versatile
GROQ_DEFAULT_FAST_MODEL=llama-3.1-8b-instant

# 3. Google Gemini Cloud Inference (Gemini 2.0 Flash / Pro)
GOOGLE_ENABLED=True
GOOGLE_API_KEY=AIzaSy_your_primary_google_gemini_api_key_here
# GEMINI_API_KEY is also accepted as an alias
# Multi-key pooling: Comma-separated keys for Google Gemini key rotation:
# GOOGLE_API_KEYS=AIzaSy_key1_here,AIzaSy_key2_here
GOOGLE_DEFAULT_PLANNER_MODEL=gemini-2.0-flash
GOOGLE_DEFAULT_FAST_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Database & Distributed Queue
# ------------------------------------------------------------------------------
# PostgreSQL (asyncpg):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/automaintainer

# Redis Streams (for task queueing):
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=redis
# Set ALLOW_IN_MEMORY_QUEUE=True only for local testing without Redis:
ALLOW_IN_MEMORY_QUEUE=False

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_high_entropy_jwt_secret_min_32_chars
SANDBOX_BACKEND=container
ALLOW_HOST_SUBPROCESS=False
